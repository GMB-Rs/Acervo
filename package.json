{
  "name": "diretorio",
  "version": "0.1.0",
  "private": true,
  "description": "Acervo — galeria curada de bibliotecas de componentes para web.",
  "license": "MIT",
  "homepage": "https://acervo.app",
  "author": "Gabriel M. Barbosa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMB-Rs/Diretorio.git"
  },
  "bugs": {
    "url": "https://github.com/GMB-Rs/Diretorio/issues"
  },
  "keywords": [
    "component-libraries",
    "design-system",
    "react",
    "vue",
    "svelte",
    "angular",
    "web-components",
    "headless-ui",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts'",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test",
    "sync:github": "node scripts/sync-github.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
